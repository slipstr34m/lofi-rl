# kit.env: cluster facts read by every script, on the laptop (scripts/*.sh, Makefile `include`) and inside
# cluster jobs (scripts/_kit_env.sh). Literal values only, no inline comments and no $VAR expansion, so that
# both bash and make can read it. No secrets: the cluster never gets credentials (CLAUDE.md §1).
# Paths verified with myquota on 2026-10-30: /project does not exist for anakano_429; /project2 does (LESSONS 6).

KIT_PROJECT=lofi-rl
KIT_GITHUB_REPO=slipstr34m/lofi-rl
KIT_BRANCH=main

# The cluster. ssh goes through scripts/_cluster_ssh.sh: BatchMode, plus an IP fallback when the macOS
# resolver cannot resolve the name on the USC network (LESSONS 30; seen 2026-10-30).
KIT_CLUSTER_HOST=discovery
KIT_CLUSTER_FQDN=discovery.usc.edu
KIT_CLUSTER_USER=shresthr
KIT_ACCOUNT=anakano_429
KIT_CONDA_MODULE=conda/25.11.0

# Where things live on Discovery (CLAUDE.md §1).
# REMOTE_PROJ is the rsync mirror of this repo (`make sync`, --delete): never put state there.
# REMOTE_KEEP is outside the mirror and persistent: envs, tools, votes backup, checkpoints, fetched assets, guard log,
# the jobs' read-only code snapshots (snap/, scripts/snapshot.py), runs a job copies there (runs/) and the render's
# one-shot cache (cache/).
# REMOTE_SCR is scratch, large but purged: logs, runs, renders, inbox, caches, HF weights (re-fetchable).
KIT_CLUSTER_PROJECT_ROOT=/project2/anakano_429/shresthr
REMOTE_PROJ=/project2/anakano_429/shresthr/lofi-rl
REMOTE_KEEP=/project2/anakano_429/shresthr/lofi-rl-keep
REMOTE_SCR=/scratch1/shresthr/lofi-rl
KIT_CLUSTER_PATH=/project2/anakano_429/shresthr/lofi-rl
KIT_CLUSTER_SCRATCH_ROOT=/scratch1/shresthr
KIT_CLUSTER_SCRATCH=/scratch1/shresthr/lofi-rl
KIT_CLUSTER_HF_HOME=/scratch1/shresthr/lofi-rl/hf

# Interpreters (built by jobs/tools.sbatch, jobs/env_policy.sbatch, jobs/env_scorer.sbatch).
KIT_TOOLS=/project2/anakano_429/shresthr/lofi-rl-keep/opt/tools
KIT_ENV_POLICY=/project2/anakano_429/shresthr/lofi-rl-keep/envs/policy
KIT_ENV_SCORER=/project2/anakano_429/shresthr/lofi-rl-keep/envs/scorer
